# Support ticket deflection & reply drafting — variable NAMES only, never values.
# Copy to .env.local (dev) and .env.test (tests). Both are gitignored.

# ── Database ────────────────────────────────────────────────────────────
# Dev/prod: this project's OWN Neon project. Data here is PII — customer
# names, order history, occasional card-last-four. One database, one access
# list. See "Project boundaries" in CLAUDE.md.
DATABASE_URL=
DIRECT_URL=

# ── Model provider ──────────────────────────────────────────────────────
# Its own key, so rotation or revocation never touches a sibling build.
ANTHROPIC_API_KEY=

# ── Ticketing ───────────────────────────────────────────────────────────
# Read-only against the resolved-ticket corpus and the macro library.
# Drafts must never be auto-sent — no credential here should permit a send.
ZENDESK_SUBDOMAIN=
ZENDESK_API_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────
# Stack not chosen yet; add its variables here when it is.
